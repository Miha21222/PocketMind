# Local frontend-only preview (`npm run dev:local`). Loaded by Vite's
# `--mode preview`. Runs the Mini App fully on localStorage with no backend and
# no Telegram auth, so the UI can be finetuned at http://localhost:5173.
#
# This file is committed on purpose and is only loaded in mode "preview" — the
# production GitHub Pages build (mode "production") never reads it.
VITE_LOCAL_PREVIEW=true
