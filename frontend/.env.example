# Backend API prefix (include the /api/v1 suffix).
VITE_API_BASE_URL=https://your-backend-domain.example.com/api/v1

# Deploy sub-path. For GitHub Pages project sites use "/<repo-name>/" (e.g. /PocketMind/).
# Leave as "/" for a user/org root site or local dev.
VITE_BASE_PATH=/PocketMind/

# Optional: dev-only Telegram initData string for browser testing outside Telegram.
# VITE_DEV_INIT_DATA=
