BOT_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///./data/pocketmind.db
MINI_APP_URL=http://localhost:5173
TUNNEL_PUBLIC_URL=
# Cloudflare Tunnel connector token (long "eyJ..." string from the Zero Trust
# dashboard, NOT the tunnel UUID). Used by the cloudflared service in
# docker-compose.single.yml to publish the backend at your stable HTTPS hostname.
TUNNEL_TOKEN=
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080
ENVIRONMENT=local
DEFAULT_TIMEZONE=Europe/Kyiv
SCHEDULER_POLL_INTERVAL_SECONDS=60

# For Docker containers, compose overrides DATABASE_URL to /app/data/pocketmind.db.
# For GitHub Pages production, set MINI_APP_URL to the published Pages URL.
