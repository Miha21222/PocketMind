BOT_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///./data/pocketmind.db
APP_BASE_URL=http://localhost:8000
MINI_APP_URL=http://localhost:5173
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
CRON_SECRET=change-me-cron-secret
TUNNEL_PUBLIC_URL=
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080
ENVIRONMENT=local
DEFAULT_TIMEZONE=Europe/Kyiv
SCHEDULER_POLL_INTERVAL_SECONDS=60

# For Docker containers, compose overrides DATABASE_URL to /app/data/pocketmind.db.
# For local Docker + tunnel run, set APP_BASE_URL and MINI_APP_URL to the printed HTTPS tunnel URL.
# For Vercel + Neon, set DATABASE_URL to postgresql+asyncpg://... with ssl=require.
